{
  "name": "Nyxdesk",
  "short_name": "Nyxdesk",
  "id": "./",
  "description": "Open, edit and save documents, spreadsheets, presentations and PDFs on your device. Nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e0b0c",
  "theme_color": "#161213",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "file",
        "accept": [
          ".docx", ".xlsx", ".pptx", ".pdf", ".csv", ".tsv", ".md", ".txt", ".html",
          "application/pdf", "text/csv", "text/plain", "text/markdown",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "application/vnd.openxmlformats-officedocument.presentationml.presentation"
        ]
      }]
    }
  },
  "file_handlers": [{
    "action": "./",
    "accept": {
      "application/pdf": [".pdf"],
      "text/csv": [".csv"],
      "text/plain": [".txt", ".md"],
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
      "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"]
    }
  }],
  "shortcuts": [
    { "name": "New document", "short_name": "Document", "url": "inkwell.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New spreadsheet", "short_name": "Sheet", "url": "abacus.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New presentation", "short_name": "Deck", "url": "marquee.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Open a PDF", "short_name": "PDF", "url": "parchment.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
